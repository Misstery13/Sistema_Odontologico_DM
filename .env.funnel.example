# Copiar a .env.funnel (nunca versionarlo). scripts/desplegar-funnel.sh lo crea y completa solo.

# Nombre de la máquina en la tailnet, sin https:// (sale de: tailscale status --json → Self.DNSName sin el punto final)
SITE_ADDRESS=servidor.tailabc123.ts.net

# Generados por el script con openssl (hexadecimal: sin / ni +)
SECRET_KEY=
POSTGRES_PASSWORD=

# Puerto local (solo 127.0.0.1) donde escucha Caddy; Funnel lo publica. Cambiar si ya está en uso.
HTTP_PORT=8090

# Puerto público de Funnel: 443, 8443 o 10000 (443 si está libre; si otra app ya lo usa, 8443)
FUNNEL_PORT=443

# 1 = cargar usuarios y pacientes de demostración (clave odonto123 y secreto MFA público).
# Cualquiera en internet podría entrar a la clínica demo: usar solo para exhibir el proyecto, nunca con datos reales.
SEED_DEMO=0

GUNICORN_WORKERS=3
GUNICORN_THREADS=4
BACKUP_RETENTION_DAYS=14
