# Copiar a .env (nunca versionar .env) y completar. Usado por docker-compose.prod.yml.

# Dominio público; Caddy obtiene el certificado TLS automáticamente (el DNS debe apuntar a este servidor)
SITE_ADDRESS=odonto.midominio.com

# Generar con: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Contraseña propia de PostgreSQL (no usar la de ejemplo)
POSTGRES_PASSWORD=

# Opcionales
GUNICORN_WORKERS=4
GUNICORN_THREADS=4
MFA_REQUIRED=1
BACKUP_RETENTION_DAYS=14
NOTE_LOCK_HOURS=24
SESSION_IDLE_MINUTES=15
MAX_DISCOUNT_PCT=15
