# Configuración compartida por desarrollo (Caddyfile) y producción (Caddyfile.prod)
(app) {
	encode gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; frame-ancestors 'none'; form-action 'self'"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Embedder-Policy require-corp
		Cross-Origin-Resource-Policy same-origin
		-Server
	}

	# datos de salud: nunca en caché del navegador ni de proxies intermedios
	@datos path /api/* /pay/*
	header @datos Cache-Control "no-store"

	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /pay/* {
		reverse_proxy payments:8080
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
